{
  "identifier": "board-editor",
  "description": "Scoped local project and board operations in the main window",
  "windows": ["main"],
  "permissions": [
    "allow-read-preferences", "allow-save-preferences",
    "allow-list-projects", "allow-choose-project", "allow-list-boards", "allow-create-board",
    "allow-rename-board", "allow-delete-board", "allow-open-board", "allow-close-board",
    "allow-apply-operation", "allow-save-drawing", "allow-import-board", "allow-export-board",
    "allow-list-verification", "allow-save-verification", "allow-remove-verification",
    "allow-open-verification-reference", "allow-export-preview", "allow-open-benchmark", "allow-finish-close", "allow-open-about-link",
    "allow-pair-client", "allow-mcp-clients", "allow-connect-client", "allow-client-config",
    "allow-install-board-skill", "allow-save-board-skill",
    "allow-list-bindings", "allow-revoke-client", "allow-queue-feedback",
    "allow-list-feedback", "allow-cancel-feedback", "allow-board-deltas",
    "allow-update-info", "allow-check-update", "allow-download-update", "allow-install-update", "allow-restart-updated",
    "core:event:allow-listen", "core:event:allow-unlisten"
  ]
}
