{
  "identifier": "board-editor",
  "description": "Scoped local project and board operations in the main window",
  "windows": ["main"],
  "permissions": [
    "allow-list-projects", "allow-choose-project", "allow-list-boards", "allow-create-board",
    "allow-rename-board", "allow-delete-board", "allow-open-board", "allow-close-board",
    "allow-apply-operation", "allow-save-drawing", "allow-import-board", "allow-export-board",
    "allow-export-preview", "allow-open-benchmark", "allow-finish-close",
    "allow-pair-client", "allow-list-bindings", "allow-revoke-client", "allow-queue-feedback",
    "allow-list-feedback", "allow-cancel-feedback", "allow-board-deltas",
    "core:event:allow-listen", "core:event:allow-unlisten"
  ]
}
